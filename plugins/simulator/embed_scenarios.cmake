#
# cmake -DSCENARIO_DIR=<data/scenarios> -DOUTPUT=<file.cpp> -P embed_scenarios.cmake
#
# Writes a C++ file with every *.json below SCENARIO_DIR as a raw string,
# keyed by its path relative to SCENARIO_DIR, so the simulator plugin
# carries its scenarios and scene files inside the library (RAD-61,
# RAD-132: self-contained, no data folder to install next to it).
file(GLOB_RECURSE _files RELATIVE ${SCENARIO_DIR} ${SCENARIO_DIR}/*.json)
list(SORT _files)
set(_out "// Generated by plugins/simulator/embed_scenarios.cmake; do not edit.\n")
string(APPEND _out "#include \"sim_scenarios.hpp\"\n\nnamespace yantra::simulator {\n\n")
string(APPEND _out "const std::vector<EmbeddedFile>& embedded_files()\n{\n")
string(APPEND _out "    static const std::vector<EmbeddedFile> files = {\n")
foreach(_f ${_files})
  file(READ ${SCENARIO_DIR}/${_f} _text)
  string(FIND "${_text}" ")yjson\"" _bad)
  if(NOT _bad EQUAL -1)
    message(FATAL_ERROR "${_f} contains the raw-string delimiter")
  endif()
  string(APPEND _out "        {\"${_f}\", R\"yjson(${_text})yjson\"},\n")
endforeach()
string(APPEND _out "    };\n    return files;\n}\n\n} // namespace yantra::simulator\n")
# Only touch the output when it changed (no needless rebuilds).
if(EXISTS ${OUTPUT})
  file(READ ${OUTPUT} _old)
  if(_old STREQUAL _out)
    return()
  endif()
endif()
file(WRITE ${OUTPUT} "${_out}")
