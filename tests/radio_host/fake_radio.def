;
; Exports of the radio host tests' fake radio plugin on Windows: the entry
; point (as cmake/radio_plugin.def of yantra-radios) and the test control
; functions of fake_control.h. YR_EXPORT is empty on Windows and the
; hidden visibility makes clang exclude every other symbol from the
; MinGW auto-export, so without this file the DLL exports nothing.
EXPORTS
    yantra_radio_entry
    fake_control
    fake_push
    fake_push_one
    fake_push_spectrum
    fake_event
    fake_unplug
    fake_replug
    fake_change_setting
    fake_query_context
