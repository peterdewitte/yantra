#
# Doxygen configuration of the plugin API reference (DOC-17), configured
# by docs/CMakeLists.txt. Copied from yantra-radios fb194f5:
# docs/api/Doxyfile.in, adapted for the plugin API.
PROJECT_NAME           = "Yantra plugin API"
PROJECT_NUMBER         = "@YANTRA_PLUGIN_API_VERSION@"
PROJECT_BRIEF          = "Stable C ABI between Yantra and its plugins"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT@
INPUT                  = @PROJECT_SOURCE_DIR@/plugin-api/include/yantra/plugin.h \
                         @PROJECT_SOURCE_DIR@/plugin-api/include/yantra/plugin.hpp
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@/include
FULL_PATH_NAMES        = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
TYPEDEF_HIDES_STRUCT   = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
HAVE_DOT               = NO
SEARCHENGINE           = YES
