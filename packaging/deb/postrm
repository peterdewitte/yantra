# Yantra .deb (NFR-09; copied from yantra-v1 c24e8f5): drop the removed udev rules from udev's memory.
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
    fi
fi
exit 0
