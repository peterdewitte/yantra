//
// Windows resources of a Yantra program (BRD-06, NFR-09): the Yantra icon
// (made from data/logo/png by make_ico.py) and the version information
// Explorer shows. Configured per program by yantra_windows_resources()
// (cmake/YantraWindowsResources.cmake), compiled by llvm-rc.
#include <winver.h>

1 ICON "@_ico@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Curtat BV"
      VALUE "FileDescription", "@_description@"
      VALUE "FileVersion", "@YANTRA_VERSION@"
      VALUE "InternalName", "@_name@"
      VALUE "LegalCopyright", "The Yantra contributors, GPL-3.0-or-later"
      VALUE "OriginalFilename", "@_name@.exe"
      VALUE "ProductName", "Yantra"
      VALUE "ProductVersion", "@YANTRA_VERSION@"
      VALUE "Comments", "https://curtat.be, source: @YANTRA_SOURCE_URL@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
