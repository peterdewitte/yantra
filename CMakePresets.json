{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang-sdk",
      "hidden": true,
      "displayName": "clang from the cross SDK of the yantra-radios submodule (OA-02; RAD-139)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/yantra-radios/tools/sdk/toolchain-x86_64-linux-gnu-clang.cmake",
        "YANTRA_SDK_DIR": "$env{YANTRA_SDK_DIR}"
      }
    },
    {
      "name": "default",
      "displayName": "Default: clang from the SDK (SIMD, app, tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "scalar",
      "displayName": "Scalar fallback without SIMD and without the app (TST-03)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-scalar",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "YANTRA_SIMD": "OFF",
        "YANTRA_BUILD_APP": "OFF"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "ci",
      "displayName": "CI build: warnings are errors (TST-02)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "YANTRA_WERROR": "ON"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "ci-scalar",
      "displayName": "CI scalar build: no SIMD, no app, warnings are errors (TST-03)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-scalar",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "YANTRA_SIMD": "OFF",
        "YANTRA_BUILD_APP": "OFF",
        "YANTRA_WERROR": "ON"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "plugins-off",
      "displayName": "PLG-01 check: without the probe and the TETRA terminal plugin",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-plugins-off",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "YANTRA_PLUGIN_PROBE": "OFF",
        "YANTRA_RADIOS_PEI": "OFF"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "ci-plugins-off",
      "displayName": "CI PLG-01 check: without the probe and the TETRA terminal plugin, warnings are errors",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-plugins-off",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "YANTRA_PLUGIN_PROBE": "OFF",
        "YANTRA_RADIOS_PEI": "OFF",
        "YANTRA_WERROR": "ON"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "asan-ubsan",
      "displayName": "AddressSanitizer + UBSan developer build (TST-05)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "YANTRA_SANITIZER": "asan-ubsan"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer developer build (TST-05)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "YANTRA_SANITIZER": "tsan"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer fuzz targets, clang + ASan/UBSan (TST-12)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "YANTRA_SANITIZER": "asan-ubsan",
        "YANTRA_FUZZ": "ON"
      },
      "inherits": "clang-sdk"
    },
    {
      "name": "gcc",
      "displayName": "System gcc, second Linux tree (OA-02)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ci-gcc",
      "displayName": "CI gcc build: warnings are errors (OA-02, TST-02)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "YANTRA_WERROR": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x64 (UCRT), cross-compiled with the SDK's clang and Yantra's MSYS2 packages; ctest runs on Windows (test VM, BUILD.md; OA-02, HW-06)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-win",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/yantra-radios/tools/sdk/toolchain-x86_64-w64-mingw32-clang.cmake",
        "YANTRA_SDK_DIR": "$env{YANTRA_SDK_DIR}",
        "YANTRA_WIN_STATIC_RUNTIME": "OFF"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows x64 cross build: warnings are errors (OA-02, TST-02)",
      "inherits": "windows",
      "cacheVariables": {
        "YANTRA_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "scalar",
      "configurePreset": "scalar"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "ci-scalar",
      "configurePreset": "ci-scalar"
    },
    {
      "name": "plugins-off",
      "configurePreset": "plugins-off"
    },
    {
      "name": "ci-plugins-off",
      "configurePreset": "ci-plugins-off"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "gcc",
      "configurePreset": "gcc"
    },
    {
      "name": "ci-gcc",
      "configurePreset": "ci-gcc"
    },
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "scalar",
      "configurePreset": "scalar",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "plugins-off",
      "configurePreset": "plugins-off",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc",
      "configurePreset": "gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows",
      "displayName": "Windows tree: run on Windows (test VM: wintest.sh test build-win, BUILD.md)",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fast",
      "displayName": "Fast tests only (every change, TST-02)",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "slow"
        }
      },
      "execution": {
        "timeout": 600
      }
    },
    {
      "name": "fast-gcc",
      "displayName": "Fast tests of the gcc tree (TST-02)",
      "configurePreset": "ci-gcc",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "slow"
        }
      },
      "execution": {
        "timeout": 600
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "timing"
        }
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "timing"
        }
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    }
  ]
}
